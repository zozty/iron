   "id": "YMYxHJN8ZdIb",
   "metadata": {
    "id": "YMYxHJN8ZdIb"
   },
   "source": [
    "## Question 10: Prime Factorization\n",
    "\n",
    "Write a function `prime_factors(n)` that takes an integer `n` greater than 1 and returns a dictionary mapping each prime factor to its exponent.\n",
    "\n",
    "Example: `prime_factors(360)` returns `{2: 3, 3: 2, 5: 1}`.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "q_fUVcQVZdIb",
   "metadata": {
    "id": "q_fUVcQVZdIb"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{2: 3, 3: 2, 5: 1}\n"
     ]
    }
   ],
   "source": [
    "def prime_factors(n):\n",
    "    factors, d = {}, 2\n",
    "    while d * d <= n:\n",
    "        while n % d == 0:\n",
    "            factors[d] = factors.get(d, 0) + 1\n",
    "            n //= d\n",
    "        d += 1\n",
    "    if n > 1:\n",
    "        factors[n] = factors.get(n, 0) + 1\n",
    "    return factors\n",
    "\n",
    "print(prime_factors(360))"
   ]
  },
